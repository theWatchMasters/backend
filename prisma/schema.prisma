// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  avatar_id          String
  theme              Theme     @default(SYSTEM)
  mfa_token          String?
  mfa_enabled        Boolean   @default(false)
  vault_amount       Float     @default(0)
  verified           Boolean   @default(false) // Whether a user has verified their email
  last_verified      DateTime  @default(now()) // The last time an email verification request has been sent
  last_exported_data DateTime? // The last time the user requested a data export
  tasks              Task[]
}

model Task {
  id        String   @id @default(uuid())
  user_id   String
  title     String?
  amount    Float
  length    Int
  ends_at   DateTime
  completed Boolean  @default(false)
  finished  Boolean  @default(false) // finished means the user has successfully completed the task, completed just means the task has ended (either successfully or unsuccessfully)

  user User @relation(fields: [user_id], references: [id])
}
